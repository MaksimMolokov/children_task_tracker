# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here

# Admin Configuration
ADMIN_TELEGRAM_ID=123456789

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/children_check

# Timezone Configuration
TIMEZONE=Europe/Moscow

# Optional: Chat IDs
# FAMILY_CHAT_ID - не используется для отправки заданий (задания отправляются только в личные сообщения)
# REPORT_CHANNEL_ID=-1001234567890  # Опционально: канал для публичных отчётов
